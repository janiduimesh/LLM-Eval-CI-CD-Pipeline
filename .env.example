# ─── Required API Keys ────────────────────────────────────────────────────────
GROQ_API_KEY=api-kay
GEMINI_API_KEY=your-gemini-api-key-here

# ─── LLM Generation Configuration (Groq) ─────────────────────────────────────
MODEL_NAME=llama-3.1-8b-instant
TEMPERATURE=0.2
MAX_TOKENS=512

# ─── Cost Rates (USD per token for Llama 3.1 8B on Groq) ────────────────────
INPUT_COST_PER_TOKEN=0.00000005
OUTPUT_COST_PER_TOKEN=0.00000008

# ─── Retriever & Embeddings (Gemini + ChromaDB) ─────────────────────────────
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3
EMBEDDING_MODEL=text-embedding-004

# ─── Evaluation Thresholds ──────────────────────────────────────────────────
ACCURACY_THRESHOLD=0.7
HALLUCINATION_THRESHOLD=0.2
LATENCY_THRESHOLD=10.0
COST_THRESHOLD=0.05
FAILED_QUESTIONS_THRESHOLD=5
